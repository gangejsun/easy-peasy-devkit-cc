{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gangejsun/easy-peasy-devkit-cc/main/schema/epcc.config.schema.json",
  "title": "EPCC Devkit Configuration",
  "description": "Configuration schema for EasyPeasy Claude Code Devkit",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "project": {
      "type": "object",
      "description": "Project metadata",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "examples": [
            "ko",
            "en",
            "id",
            "vi",
            "ja",
            "zh"
          ],
          "default": "en",
          "description": "Response language (BCP-47 tag). Not an enum — /epcc-init offers ko/en/id/vi plus free entry, so any valid tag is accepted. Internal reasoning stays English; output is localized for meaning, and industry-standard technical terms stay in English."
        },
        "languageLabel": {
          "type": "string",
          "description": "Endonym shown in the T0 language directive, e.g. 한국어, Bahasa Indonesia, Tiếng Việt. Written by /epcc-init for languages outside the known set; session-brief.sh falls back to `language` when absent."
        },
        "experienceLevel": {
          "type": "string",
          "enum": [
            "senior",
            "mid",
            "junior"
          ],
          "default": "senior",
          "description": "Developer experience level — affects response detail"
        }
      },
      "required": [
        "name"
      ]
    },
    "techStack": {
      "type": "object",
      "description": "Technology stack configuration",
      "properties": {
        "preset": {
          "type": "string",
          "default": "none+none",
          "description": "레거시 단일축 이름('nextjs-supabase' 등) 또는 복합 표기 '<frontend>+<backend>'. 신규 설정은 presets 객체를 정본으로 쓰고 이 필드는 하위 호환용으로 함께 기록한다"
        },
        "deliveryModel": {
          "type": "string",
          "enum": [
            "web",
            "hybrid",
            "native",
            "api-only"
          ],
          "description": "제품이 사용자에게 도달하는 형태. 축이 아니라 차원이다 — 팩을 고르지 않고 팩의 조건부 슬롯(오프라인·셸·인증 전달·푸시)을 켜고 끈다. hybrid는 웹 코드를 네이티브 셸로 감싸는 형태(Capacitor 등), native는 React Native·Flutter·Swift·Kotlin을 통칭한다(대응 축 팩이 없어 생성 경로를 탄다)"
        },
        "clientKind": {
          "type": "string",
          "enum": [
            "browser",
            "app"
          ],
          "description": "deliveryModel의 파생값 — 'web'이면 browser, 나머지 셋은 app. 백엔드·인프라 가이드가 보는 유일한 값이다. 각 팩이 제각기 재유도하면 서술이 갈리므로 여기 한 곳에서 정하고 팩은 이 값만 본다. browser면 쿠키 세션·CSRF, app이면 Bearer + 보안 저장소·멱등 배치 수집·푸시·API 버전 협상 슬롯이 살아난다"
        },
        "pwa": {
          "type": "boolean",
          "description": "deliveryModel이 'web'일 때만 의미가 있다. true면 프론트엔드 가이드의 서비스워커·매니페스트·오프라인 캐시·설치 프롬프트·업데이트 전략 슬롯이 살아난다"
        },
        "nativeStack": {
          "type": "string",
          "description": "deliveryModel이 'native'일 때 실제 사용 기술(React Native·Flutter·Swift·Kotlin 등). 대응 축 팩이 없으므로 프론트엔드 가이드는 이 값을 입력으로 생성된다"
        },
        "vcsPlatform": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "description": "코드 호스팅 플랫폼. 축이 아니라 차원이다 — 어느 가이드 팩을 설치할지 바꾸지 않고 이슈·변경 요청 명령만 가른다(gh ↔ glab/push 옵션, PR ↔ MR, 참조 기호 #N ↔ !N). 값이 없으면 기본값으로 넘어가지 않는다: 'git remote get-url origin'으로 판정하고 그래도 불명이면 사용자에게 묻는다"
        },
        "framework": {
          "type": "string",
          "description": "프로젝트 대표 프레임워크 (축별 상세는 techStack.frontend/backend). 하위 호환 유지 필드"
        },
        "language": {
          "type": "string",
          "description": "프로젝트 대표 언어 (축별 상세는 techStack.frontend/backend). 하위 호환 유지 필드"
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "bun",
            "uv",
            "pip"
          ],
          "default": "npm"
        },
        "commands": {
          "type": "object",
          "properties": {
            "build": {
              "type": "string"
            },
            "test": {
              "type": "string"
            },
            "lint": {
              "type": "string"
            },
            "sonar": {
              "type": "string"
            }
          },
          "description": "프로젝트 대표 명령. build-gate·health-check가 읽는 값이므로 반드시 채운다. sonar는 선택이며 SonarQube를 쓰는 프로젝트만 채운다(health-check Step 5.5가 읽는다). 축별로 툴체인이 다르면 각 축의 commands에 따로 기록하고 여기에는 대표값을 둔다"
        },
        "backend": {
          "type": "object",
          "description": "백엔드 축. 프리셋 값은 기본값이며 인터뷰에서 확정된다. 자체 서버 조합이면 프론트엔드와 다른 툴체인(언어·패키지 매니저·명령)을 가질 수 있다",
          "properties": {
            "backendType": {
              "type": "string",
              "enum": [
                "baas",
                "serverless",
                "cloud-server",
                "framework-builtin",
                ""
              ],
              "description": "baas(Supabase·Firebase — 벤더가 DB·인증·스토리지를 함께 제공) / serverless(AWS Lambda·GCP Cloud Functions — 함수 단위 배포, 상주 서버 없음) / cloud-server(직접 운영하는 API 서버 — FastAPI·Express 등) / framework-builtin(Next.js Route Handlers 등 프론트 프레임워크 내장)"
            },
            "cloudProvider": {
              "type": [
                "string",
                "null"
              ],
              "description": "AWS / GCP / Azure / Vercel / 자체 호스팅 (serverless·cloud-server일 때 필수)"
            },
            "database": {
              "type": "string",
              "description": "PostgreSQL / MySQL / MongoDB / DynamoDB / ..."
            },
            "dataAccess": {
              "type": "string",
              "description": "Prisma / Drizzle / SQLAlchemy / SDK direct / ..."
            },
            "auth": {
              "type": "string",
              "description": "Supabase Auth / NextAuth / Cognito / custom"
            },
            "framework": {
              "type": "string",
              "description": "자체 서버일 때의 프레임워크 (FastAPI / Express / ...). BaaS면 빈 값"
            },
            "language": {
              "type": "string"
            },
            "packageManager": {
              "type": "string",
              "enum": [
                "npm",
                "pnpm",
                "yarn",
                "bun",
                "uv",
                "pip",
                ""
              ]
            },
            "commands": {
              "type": "object",
              "properties": {
                "build": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "lint": {
                  "type": "string"
                },
                "sonar": {
                  "type": "string"
                }
              }
            },
            "sourceDir": {
              "type": "string"
            }
          }
        },
        "additionalStack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional technologies (e.g., 'Tailwind CSS v4', 'Supabase')"
        },
        "presets": {
          "type": "object",
          "description": "2축 프리셋 선택. 두 축이 모두 정해져야 스택 조합이 확정되고, 가이드는 그 조합 전체를 보고 생성된다",
          "properties": {
            "frontend": {
              "type": "string",
              "enum": [
                "nextjs",
                "react-vite",
                "vue",
                "vanilla",
                "none"
              ],
              "description": "presets/frontend/<name>.json"
            },
            "backend": {
              "type": "string",
              "enum": [
                "supabase",
                "firebase",
                "aws-serverless",
                "aws-container",
                "gcp-serverless",
                "fastapi",
                "node-api",
                "node-nest",
                "none"
              ],
              "description": "presets/backend/<name>.json"
            }
          },
          "required": [
            "frontend",
            "backend"
          ]
        },
        "frontend": {
          "type": "object",
          "description": "프론트엔드 축. 프리셋 값은 기본값이며 인터뷰에서 확정된다",
          "properties": {
            "framework": {
              "type": "string",
              "description": "Next.js 15 (App Router) / React + Vite / ..."
            },
            "language": {
              "type": "string",
              "description": "TypeScript / JavaScript — 가이드의 타입 표준 슬롯이 이 값에 따라 달라진다"
            },
            "packageManager": {
              "type": "string",
              "enum": [
                "npm",
                "pnpm",
                "yarn",
                "bun",
                ""
              ]
            },
            "commands": {
              "type": "object",
              "properties": {
                "build": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "lint": {
                  "type": "string"
                },
                "sonar": {
                  "type": "string"
                }
              }
            },
            "sourceDir": {
              "type": "string"
            },
            "additionalStack": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "preset"
      ]
    },
    "domains": {
      "type": "object",
      "description": "Domain boundary configuration for the guard hook",
      "properties": {
        "sourceDir": {
          "type": "string",
          "default": "src",
          "description": "Source code root directory"
        },
        "sharedPackage": {
          "type": "string",
          "description": "Shared package path (requires approval to modify)"
        },
        "importAlias": {
          "type": "string",
          "description": "Import alias (e.g., '@/')"
        },
        "repoTopology": {
          "type": "string",
          "enum": [
            "monorepo",
            "single",
            "msa"
          ],
          "default": "monorepo",
          "description": "Repository topology chosen at epcc-init (drives the generated project-structure rule card)"
        }
      }
    }
  },
  "required": [
    "project",
    "techStack"
  ]
}
